@prefix voc: <https://ref.gs1.org/voc/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

voc:GS1ClassValidationShape
    a sh:NodeShape ;
    sh:targetSubjectsOf rdf:type ;

    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Class {?type} is not a valid GS1 Web Vocabulary class." ;

        sh:select """
            SELECT $this ?type
            WHERE {
                $this rdf:type ?type .

                # Only check GS1 namespace
                FILTER(STRSTARTS(STR(?type), "https://ref.gs1.org/voc/"))

                # Check that the class does NOT exist in the ontology
                FILTER NOT EXISTS {
                    ?type a owl:Class .
                }
            }
        """ ;
    ] .

